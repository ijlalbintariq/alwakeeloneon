# Core runtime
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=verify-full
PGHOST=host

# Session/auth security
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SETUP_KEY=replace-with-bootstrap-key-for-production

# Optional admin seed (disabled by default)
ENABLE_ADMIN_SEED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
SEED_ADMIN_TIER=pro

# AI providers
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=

# Google sign-in
GOOGLE_CLIENT_ID=

# Email / password reset
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FROM_EMAIL=

# Optional integrations (legacy/internal)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional Cloudflare R2 object storage for raw uploaded files
# If unset, uploads continue to use legacy DB-only text storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
# Optional CDN/public base URL (for example: https://cdn.example.com/bucket)
R2_PUBLIC_BASE_URL=

# Optional local transcription
# whisper.cpp binary (e.g. /usr/local/bin/whisper-cli) and model file path (e.g. /models/ggml-base.en.bin)
WHISPER_BIN_PATH=
WHISPER_MODEL_PATH=
WHISPER_CPP_THREADS=4
WHISPER_CPP_LANGUAGE=auto

# Optional RAG retrieval tuning
# semantic => attempts local transformer embeddings (no API billing, falls back automatically if unavailable)
# hashing => deterministic lexical fallback only
# In production, prefer hashing unless you have enough memory headroom.
RAG_EMBEDDING_PROVIDER=hashing
RAG_SEMANTIC_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DIM=384
RAG_MIN_SCORE=0.50
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHUNKS=5
RAG_FORCE_CONTEXT=true
RAG_VECTOR_WEIGHT=0.72
RAG_KEYWORD_WEIGHT=0.28
RAG_INDEX_BATCH_SIZE=8
RAG_MAX_CHUNKS_PER_DOC=600

# Optional GitHub knowledge sync safeguards (recommended for low-memory instances)
GITHUB_SYNC_ENABLED=false
GITHUB_SYNC_MAX_FILE_BYTES=2097152
GITHUB_SYNC_MAX_TEXT_CHARS=200000
GITHUB_SYNC_MAX_FILES=400
GITHUB_SYNC_BATCH_SIZE=2
GITHUB_SYNC_AUTO_EXTRACT=false

# Optional auto-extract queue memory safeguards
AUTO_EXTRACT_MAX_QUEUE_SIZE=200
AUTO_EXTRACT_MAX_ITEM_TEXT_CHARS=160000
AUTO_EXTRACT_MAX_TOTAL_QUEUE_CHARS=1200000

# Optional PDF OCR fallback for scanned/image PDFs (requires system binaries)
# Install both `tesseract` and `pdftoppm` (poppler-utils) on the host.
TESSERACT_OCR_LANG=eng+urd
PDF_OCR_MAX_PAGES=8
PDF_OCR_DPI=220
PDF_OCR_TIMEOUT_MS=120000

# Optional file malware scanning
FILE_SCAN_MODE=optional
FILE_SCAN_BIN=clamscan
FILE_SCAN_ARGS=--no-summary
FILE_SCAN_TIMEOUT_MS=20000

# Optional proxy bypass
NO_PROXY=
no_proxy=
