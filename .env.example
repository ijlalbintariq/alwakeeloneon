# Core runtime
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=verify-full
PGHOST=host

# Session/auth security
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SETUP_KEY=replace-with-bootstrap-key-for-production

# Optional admin seed (disabled by default)
ENABLE_ADMIN_SEED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
SEED_ADMIN_TIER=pro

# AI providers
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=

# Google sign-in
GOOGLE_CLIENT_ID=

# Email / password reset
RESEND_API_KEY=
FROM_EMAIL=

# Optional integrations (legacy/internal)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional local transcription
WHISPER_BIN_PATH=
WHISPER_MODEL_PATH=

# Optional PDF OCR fallback for scanned/image PDFs (requires system binaries)
# Install both `tesseract` and `pdftoppm` (poppler-utils) on the host.
TESSERACT_OCR_LANG=eng+urd
PDF_OCR_MAX_PAGES=8
PDF_OCR_DPI=220
PDF_OCR_TIMEOUT_MS=120000

# Optional file malware scanning
FILE_SCAN_MODE=optional
FILE_SCAN_BIN=clamscan
FILE_SCAN_ARGS=--no-summary
FILE_SCAN_TIMEOUT_MS=20000

# Optional proxy bypass
NO_PROXY=
no_proxy=
